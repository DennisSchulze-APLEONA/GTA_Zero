


<Window x:Class="GTA_Zero.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="GTA Zero" Height="720" Width="1050"
        KeyDown="Window_KeyDown" KeyUp="Window_KeyUp"
        MouseMove="Window_MouseMove" MouseDown="Window_MouseDown" MouseUp="Window_MouseUp">
    <Grid>
        <Canvas x:Name="ViewportCanvas" Background="#1E1E1E" ClipToBounds="True">

            <!-- 2000x2000 City Map -->
            <Canvas x:Name="WorldCanvas" Width="2000" Height="2000" Background="#2B2B2B"/>

            <!-- Top-Left HUD -->
            <Border Background="#CC000000" CornerRadius="6" Padding="12" Canvas.Left="15" Canvas.Top="15">
                <StackPanel>
                    <TextBlock x:Name="ScoreText" Foreground="Gold" FontSize="18" FontWeight="Bold" Text="SCORE: $0"/>
                    <TextBlock x:Name="WantedText" Foreground="DeepSkyBlue" FontSize="15" FontWeight="Bold" Text="WANTED: ☆ ☆ ☆ ☆ ☆"/>
                    <TextBlock x:Name="WeaponText" Foreground="Orange" FontSize="14" FontWeight="Bold" Text="WEAPON: PISTOL (∞)"/>
                    <TextBlock x:Name="CarHpText" Foreground="LightGreen" FontSize="13" Text="ON FOOT"/>
                    <TextBlock Foreground="#CCCCCC" FontSize="11.5" Margin="0,6,0,0"
                               Text="WASD: Move/Drive | Left-Click (Hold): Shoot | F: Enter/Exit Car | R: Restart"/>
                </StackPanel>
            </Border>

            <!-- Center Game Over Banner -->
            <Border x:Name="GameOverBanner" Visibility="Collapsed" Background="#DD8B0000" 
                    CornerRadius="10" Padding="25" Canvas.Left="340" Canvas.Top="280">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="WASTED!" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="FinalScoreText" Text="Final Score: $0" Foreground="Gold" FontSize="20" HorizontalAlignment="Center" Margin="0,5,0,10"/>
                    <TextBlock Text="Press [R] to Respawn" Foreground="White" FontSize="15" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
